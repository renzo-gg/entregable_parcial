@model SolicitudIndexViewModel
@{
    ViewData["Title"] = "Mis solicitudes";
}

<div class="page-header">
    <div>
        <h1>Mis solicitudes</h1>
        <p class="lead">Solicitudes de crédito y su estado de evaluación.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg">
        Solicitar crédito
    </a>
</div>

<form method="get" asp-action="Index" class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label asp-for="Estado" class="form-label"></label>
                <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoSolicitud>()" class="form-select">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="MontoMin" class="form-label"></label>
                <input asp-for="MontoMin" class="form-control" placeholder="0.00" />
                <span asp-validation-for="MontoMin" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="MontoMax" class="form-label"></label>
                <input asp-for="MontoMax" class="form-control" placeholder="0.00" />
                <span asp-validation-for="MontoMax" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="FechaDesde" class="form-label"></label>
                <input asp-for="FechaDesde" class="form-control" />
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="FechaHasta" class="form-label"></label>
                <input asp-for="FechaHasta" class="form-control" />
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </div>
        <div asp-validation-summary="All" class="text-danger mt-3 mb-0"></div>
    </div>
</form>

@if (Model.Solicitudes.Any())
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Monto solicitado</th>
                        <th>Fecha de solicitud</th>
                        <th>Estado</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var solicitud in Model.Solicitudes)
                    {
                        <tr>
                            <td class="fw-semibold">@solicitud.Id</td>
                            <td class="fw-semibold">@solicitud.MontoSolicitado.ToString("C2")</td>
                            <td class="text-muted">@solicitud.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="badge @solicitud.Estado.BadgeCssClass()">@solicitud.Estado</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@solicitud.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info d-flex align-items-center gap-2">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span>No tienes solicitudes que coincidan con los filtros.</span>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}