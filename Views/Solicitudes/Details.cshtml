@model SolicitudDetalleViewModel
@{
    ViewData["Title"] = $"Solicitud #{Model.Id}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Mis solicitudes</a></li>
        <li class="breadcrumb-item active" aria-current="page">Solicitud #@Model.Id</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card overflow-hidden">
            <div class="app-card-grad card-header d-flex justify-content-between align-items-center">
                <span class="fs-5 fw-bold">Solicitud #@Model.Id</span>
                <span class="badge @Model.Estado.BadgeCssClass()">@Model.Estado</span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted fw-normal">Correo del cliente</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.ClienteEmail</dd>

                    <dt class="col-sm-5 text-muted fw-normal">Monto solicitado</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.MontoSolicitado.ToString("C2")</dd>

                    <dt class="col-sm-5 text-muted fw-normal">Fecha de solicitud</dt>
                    <dd class="col-sm-7">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-5 text-muted fw-normal">Ingresos mensuales</dt>
                    <dd class="col-sm-7">@Model.IngresosMensuales.ToString("C2")</dd>

                    <dt class="col-sm-5 text-muted fw-normal">Cliente activo</dt>
                    <dd class="col-sm-7">
                        @if (Model.ClienteActivo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </dd>

                    <dt class="col-sm-5 text-muted fw-normal">Estado</dt>
                    <dd class="col-sm-7">
                        <span class="badge @Model.Estado.BadgeCssClass()">@Model.Estado</span>
                    </dd>

                    @if (!string.IsNullOrWhiteSpace(Model.MotivoRechazo))
                    {
                        <dt class="col-sm-5 text-muted fw-normal">Motivo de rechazo</dt>
                        <dd class="col-sm-7">@Model.MotivoRechazo</dd>
                    }
                </dl>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Volver a mis solicitudes</a>
        </div>
    </div>
</div>