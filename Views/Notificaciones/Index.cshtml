@model NotificacionesIndexViewModel
@{
    ViewData["Title"] = "Mis notificaciones";
}

<h1>Mis notificaciones</h1>
<p class="text-muted">Avisos generados por el estado de tus solicitudes.</p>

@if (Model.Notificaciones.Count == 0)
{
    <div class="alert alert-info">Aún no tienes notificaciones.</div>
}
else
{
    <div class="list-group">
        @foreach (var notificacion in Model.Notificaciones)
        {
            <div class="list-group-item d-flex justify-content-between align-items-start">
                <div>
                    <div class="fw-semibold">@notificacion.Contenido</div>
                    <div class="text-muted small">
                        <span class="badge text-bg-secondary">@notificacion.Tipo</span>
                        Evento: @notificacion.FechaEventoUtc.ToString("dd/MM/yyyy HH:mm:ss 'UTC'") ·
                        Recibido: @notificacion.FechaRegistroUtc.ToString("dd/MM/yyyy HH:mm:ss 'UTC'")
                    </div>
                </div>
                <a asp-controller="Solicitudes" asp-action="Details" asp-route-id="@notificacion.SolicitudId"
                   class="btn btn-sm btn-outline-primary">Ver solicitud</a>
            </div>
        }
    </div>
}