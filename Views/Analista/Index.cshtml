@model AnalistaIndexViewModel
@{
    ViewData["Title"] = "Panel del analista";
}

<h1>Panel del analista</h1>
<p class="text-muted">Solicitudes en estado Pendiente listas para evaluar.</p>

@if (TempData["Exito"] is not null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Solicitudes.Count == 0)
{
    <div class="alert alert-info">No hay solicitudes pendientes por evaluar.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Cliente</th>
                    <th>Monto solicitado</th>
                    <th>Ingresos mensuales</th>
                    <th>Maximo a aprobar (5x)</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var solicitud in Model.Solicitudes)
                {
                    <tr>
                        <td>@solicitud.Id</td>
                        <td>@solicitud.ClienteEmail</td>
                        <td>S/ @solicitud.MontoSolicitado.ToString("N2")</td>
                        <td>S/ @solicitud.IngresosMensuales.ToString("N2")</td>
                        <td>S/ @solicitud.MontoMaximoAprobar.ToString("N2")</td>
                        <td>@solicitud.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="d-flex gap-2">
                            <form asp-action="Aprobar" asp-route-id="@solicitud.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success">Aprobar</button>
                            </form>
                            <a asp-action="Rechazar" asp-route-id="@solicitud.Id" class="btn btn-sm btn-outline-danger">Rechazar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}