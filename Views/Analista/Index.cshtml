@model AnalistaIndexViewModel
@{
    ViewData["Title"] = "Panel del analista";
}

<div class="page-header">
    <div>
        <h1>Panel del analista</h1>
        <p class="lead">Solicitudes en estado <span class="badge bg-warning">Pendiente</span> listas para evaluar.</p>
    </div>
    <span class="stat-chip">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
        </svg>
        Pendientes: @Model.Solicitudes.Count
    </span>
</div>

@if (TempData["Exito"] is not null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Solicitudes.Count == 0)
{
    <div class="alert alert-info d-flex align-items-center gap-2">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line>
        </svg>
        <span>No hay solicitudes pendientes por evaluar.</span>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Cliente</th>
                        <th>Monto solicitado</th>
                        <th>Ingresos mensuales</th>
                        <th>Máximo a aprobar (5x)</th>
                        <th>Fecha</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var solicitud in Model.Solicitudes)
                    {
                        <tr>
                            <td class="fw-semibold">@solicitud.Id</td>
                            <td>@solicitud.ClienteEmail</td>
                            <td class="fw-semibold">S/ @solicitud.MontoSolicitado.ToString("N2")</td>
                            <td>S/ @solicitud.IngresosMensuales.ToString("N2")</td>
                            <td>
                                <span class="badge bg-soft-primary">S/ @solicitud.MontoMaximoAprobar.ToString("N2")</span>
                            </td>
                            <td class="text-muted">@solicitud.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <form asp-action="Aprobar" asp-route-id="@solicitud.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success">
                                            Aprobar
                                        </button>
                                    </form>
                                    <a asp-action="Rechazar" asp-route-id="@solicitud.Id" class="btn btn-sm btn-outline-danger">
                                        Rechazar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}