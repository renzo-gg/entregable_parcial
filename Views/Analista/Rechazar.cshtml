@model RechazarSolicitudViewModel
@{
    ViewData["Title"] = $"Rechazar solicitud #{Model.SolicitudId}";
}

<div class="page-header">
    <div>
        <h1>Rechazar solicitud #@Model.SolicitudId</h1>
        <p class="lead">Especifica el motivo por el cual se rechaza la solicitud.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <div class="card mb-4">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-normal">Cliente</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.ClienteEmail</dd>
                    <dt class="col-sm-4 text-muted fw-normal">Monto solicitado</dt>
                    <dd class="col-sm-8 fw-semibold">S/ @Model.MontoSolicitado.ToString("N2")</dd>
                    <dt class="col-sm-4 text-muted fw-normal">Ingresos mensuales</dt>
                    <dd class="col-sm-8">S/ @Model.IngresosMensuales.ToString("N2")</dd>
                </dl>
            </div>
        </div>

        <form asp-action="Rechazar" method="post" class="card">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="SolicitudId" />
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="MotivoRechazo" class="form-label"></label>
                    <textarea asp-for="MotivoRechazo" class="form-control" rows="4"
                              placeholder="Indique el motivo por el cual se rechaza la solicitud..."></textarea>
                    <span asp-validation-for="MotivoRechazo" class="text-danger"></span>
                    <div class="text-muted small mt-1">Campo obligatorio.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        Confirmar rechazo
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}